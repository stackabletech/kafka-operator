# The brokers bootstrap the KRaft quorum via this Service. It selects the controllers of all role
# groups, but only the ready ones.
apiVersion: v1
kind: Service
metadata:
  name: test-kafka-controller-headless
spec:
  clusterIP: None
  publishNotReadyAddresses: false
  selector:
    app.kubernetes.io/component: controller
    app.kubernetes.io/instance: test-kafka
    app.kubernetes.io/name: kafka
  ports:
  - name: kafka-tls
    port: 9093
    protocol: TCP
    targetPort: 9093
