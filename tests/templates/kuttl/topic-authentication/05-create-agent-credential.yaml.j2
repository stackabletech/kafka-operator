{% if test_scenario['values']['platform-access-authentication'] == 'secret' %}
---
# A CA trusted by the brokers for client authentication, and a certificate for the agent signed by
# it, as a user would provide them
apiVersion: kuttl.dev/v1beta1
kind: TestStep
commands:
  - script: |
      set -eu
      dir=$(mktemp -d)
      printf "basicConstraints=CA:FALSE\nextendedKeyUsage=clientAuth\n" > "$dir/extensions.cnf"
      openssl req -x509 -newkey rsa:2048 -nodes -days 30 \
        -subj "/CN=Test client CA" \
        -addext "basicConstraints=critical,CA:TRUE" \
        -addext "keyUsage=critical,keyCertSign,cRLSign" \
        -keyout "$dir/ca.key" -out "$dir/ca.crt"
      openssl req -newkey rsa:2048 -nodes \
        -subj "/CN=kafka-agent" \
        -keyout "$dir/tls.key" -out "$dir/tls.csr"
      openssl x509 -req -days 30 -in "$dir/tls.csr" \
        -CA "$dir/ca.crt" -CAkey "$dir/ca.key" -CAcreateserial \
        -extfile "$dir/extensions.cnf" \
        -out "$dir/tls.crt"
      kubectl create secret generic client-auth-ca --namespace "$NAMESPACE" \
        --from-file=ca.crt="$dir/ca.crt" --from-file=ca.key="$dir/ca.key"
      kubectl create secret tls kafka-agent-credential --namespace "$NAMESPACE" \
        --cert="$dir/tls.crt" --key="$dir/tls.key"
      rm -r "$dir"
{% endif %}
