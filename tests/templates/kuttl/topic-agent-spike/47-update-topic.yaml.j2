---
apiVersion: kuttl.dev/v1beta1
kind: TestStep
timeout: 300
---
# Update the existing topic: grow partitions 6 -> 9 and change retention. Exercises the "topic already
# exists" branch of ensure_topic (CreatePartitions + IncrementalAlterConfigs) — the create-fresh path
# was covered at step 40. Growing partitions keeps existing messages (new partitions start empty), so
# the total message count is unchanged for the no-loss check at step 70.
apiVersion: kafka.stackable.tech/v1alpha1
kind: KafkaTopic
metadata:
  name: test-topic
spec:
  clusterRef:
    name: test-kafka
  topicName: test-topic
  partitions: 9
  replicationFactor: 2
  config:
    retention.ms: "1200000"
