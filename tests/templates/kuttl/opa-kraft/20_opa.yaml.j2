---
apiVersion: v1
kind: ConfigMap
metadata:
  name: test-rego-kafka
  labels:
    opa.stackable.tech/bundle: "true"
data:
  kafka.rego: |
    package authz

    internal_listeners := {"INTERNAL", "CONTROLLER"}

    # Regular expression matching the subject DN of the internal TLS certificates of the Pods of
    # a role group.
    subject_dn_pattern(role_group) := pattern if {
      fqdn := [
        `local`,
        `cluster`,
        `svc`,
        `$NAMESPACE`,
        concat("", [role_group, `-headless`]),
        concat("", [role_group, `-[0-9]+`]),
      ]
      domain_components := [concat("", [`DC=`, dc]) | some dc in fqdn]
      fields := array.concat(domain_components, [`CN=generated certificate for pod`])
      pattern := concat("", ["^", concat(",", fields), "$"])
    }

    node_role_groups := [
      `test-kafka-broker-default`,
      `test-kafka-controller-default`,
    ]

    is_internal_request if input.requestContext.listenerName in internal_listeners

    is_kafka_node if {
      some role_group in node_role_groups
      regex.match(subject_dn_pattern(role_group), input.requestContext.principal.name)
    }

    default allow := false

    # The Kafka nodes are not super users, so their traffic must be allowed explicitly.
    allow if {
      is_internal_request
      is_kafka_node
    }

    # Client requests that the brokers forward to the controllers (e.g. creating topics) are
    # authorized on the CONTROLLER listener, so the client rules are not restricted to a listener.
    allow if {
      input.requestContext.principal.name == "developer"
      resource_is_allowed
    }

    # The (idempotent) producer needs this cluster-level permission.
    allow if {
      input.requestContext.principal.name == "developer"
      input.action.resourcePattern.resourceType == "CLUSTER"
      input.action.operation == "IDEMPOTENT_WRITE"
    }

    # only allow access to a specific topic
    resource_is_allowed if {
      input.action.resourcePattern.resourceType == "TOPIC"
      input.action.resourcePattern.name == "test-topic"
      action_is_allowed
    }

    resource_is_allowed if {
      input.action.resourcePattern.resourceType == "GROUP"
      input.action.operation in ["DESCRIBE", "READ"]
    }

    action_is_allowed if {
      input.action.operation in ["CREATE", "DESCRIBE", "READ", "WRITE"]
    }
---
apiVersion: opa.stackable.tech/v1alpha1
kind: OpaCluster
metadata:
  name: test-opa
spec:
  image:
{% if test_scenario['values']['opa-latest'].find(",") > 0 %}
    custom: "{{ test_scenario['values']['opa-latest'].split(',')[1] }}"
    productVersion: "{{ test_scenario['values']['opa-latest'].split(',')[0] }}"
{% else %}
    productVersion: "{{ test_scenario['values']['opa-latest'] }}"
{% endif %}
    pullPolicy: IfNotPresent
  clusterConfig:
{% if test_scenario['values']['use-opa-tls'] == "true" %}
    tls:
      serverSecretClass: opa-tls-$NAMESPACE
{% endif %}
    vectorAggregatorConfigMapName: vector-aggregator-discovery
  servers:
    config:
      logging:
        enableVectorAgent: true
        containers:
          opa:
            console:
              level: INFO
            file:
              level: INFO
            loggers:
              decision:
                level: INFO
    roleGroups:
      default: {}
